# Cloudflare Pages rewrites — every path below is a client-side route handled by
# assets/js/app.js, so each one has to serve the app shell instead of a 404.
# `/api/*` is untouched: Pages Functions run before these rules.

# Public pages
/about        /    200
/terms        /    200
/privacy      /    200
/blog         /    200
/blog/*       /    200
/contact      /    200
/app-store    /    200

# TrueBill verification
/verify/*     /    200
/invoice/*    /    200

# Sign-in entry points (e.g. https://your-domain/owner)
/owner            /    200
/administrator    /    200
/admin            /    200
/shop             /    200

# Consoles — the page is the last URL segment
/ownerconsole          /    200
/ownerconsole/*        /    200
/administratorconsole  /    200
/administratorconsole/* /   200
/shopconsole           /    200
/shopconsole/*         /    200

# SPA catch-all — MUST stay last.
#
# A shallow path such as /pricing or a mistyped link has no explicit rule above,
# so without this Pages answers with its own 404 page and the visitor never sees
# the app (and loses the site chrome). Cloudflare evaluates _redirects top to
# bottom and stops at the first match, and real files win over rules, so static
# assets are unaffected by this line.
#
# Assets keep honest 404s: a missing /assets/* file must not be answered with
# HTML, or the browser reports "Unexpected token '<'" instead of a clear 404.
/assets/*    /assets/:splat   404
/*           /index.html      200
